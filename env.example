# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" preenchido para o GitHub.

# Connection string do seu projeto Supabase (Settings > Database > Connection string)
SUPABASE_DB_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres

# Credenciais da conta de serviço do Google Earth Engine
GEE_SERVICE_ACCOUNT=seu-servico@seu-projeto.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./chave-gee.json

# Caminho do GeoJSON com os municípios do semiárido de PE (usado só na carga inicial)
MUNICIPIOS_GEOJSON=municipios_semiarido_pe.geojson

# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" preenchido para o GitHub.

# URL do endpoint de ingestão criado pelo Lovable (use a URL de PRODUÇÃO,
# depois de publicar o app — a de preview pode não ficar sempre disponível)
INGEST_URL=https://SEU-PROJETO.lovable.app/api/public/ingest

# Token gerado com openssl rand -hex 32, o mesmo salvo como secret no Lovable
INGEST_TOKEN=cole_aqui_o_token_que_voce_gerou

# Credenciais da conta de serviço do Google Earth Engine
GEE_SERVICE_ACCOUNT=desertificacao-pe@desertificacao-pe.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./chave-gee.json

# Arquivo local com a lista de municípios e suas geometrias
MUNICIPIOS_GEOJSON=pe_municipios.json
